// ---------------------------------------------------------------------------
// Transport Management System — Prisma Schema
//
// This file is a direct translation of docs/01-architecture/database_schema.md.
// It introduces no tables, columns, relationships or constraints of its own.
//
// Two classes of constraint required by database_schema.md cannot be expressed
// in Prisma's schema language and MUST be added by hand in a migration.
// They are listed here so they are not silently lost, and repeated as a comment
// on each model that needs them.
//
//   PARTIAL UNIQUE INDEXES (Prisma has no filtered-index syntax)
//     driver              UNIQUE (licence_number)           WHERE is_active
//     vehicle             UNIQUE (license_plate)            WHERE is_active
//     trailer             UNIQUE (license_plate)            WHERE is_active
//     custom_property     UNIQUE (name)                     WHERE is_active
//     custom_property     UNIQUE (pricing_component_id)     WHERE is_active
//     pricing_component   UNIQUE (code)                     WHERE is_active
//     route_pricing       UNIQUE (departure, destination)
//                                             WHERE combination_group_id IS NULL
//     route_pricing       UNIQUE (departure, destination)
//                                         WHERE combination_group_id IS NOT NULL
//     route_pricing       UNIQUE (combination_group_id, combination_leg_position)
//                                         WHERE combination_group_id IS NOT NULL
//     route_cost          UNIQUE (departure, destination, pricing_component_id)
//                                 WHERE is_active AND route_pricing_id IS NULL
//     route_cost          UNIQUE (route_pricing_id, pricing_component_id)
//                             WHERE is_active AND route_pricing_id IS NOT NULL
//     vehicle_assignment  UNIQUE (vehicle_id)               WHERE valid_to IS NULL
//
//   CHECK CONSTRAINTS (Prisma has no CHECK syntax)
//     parser_run          warning_count >= 0
//     parser_run          error_count >= 0
//     trip                waiting_time_minutes >= 0
//     trip                distance_km >= 0
//     vacation            end_date >= start_date
//     vehicle_assignment  valid_to >= valid_from
//     maintenance         exactly one of vehicle_id / trailer_id is set
//     maintenance         cost >= 0
//     route_pricing       base_price >= 0
//     route_pricing       combination_leg_position IS NULL exactly when
//                         combination_group_id is
//     route_pricing       combination_leg_position IN (1, 2)
//     route_cost          amount >= 0
//     custom_property     default_price IS NULL when pricing_component_id is set
//     trip_pricing        total_price >= 0
//     calendar_event      end_date >= start_date
//
// Using a plain @@unique instead of a partial unique index would be a silent
// behaviour change: it would permanently reserve a licence plate / property
// name / component code, which the model explicitly allows to be reused once
// the owning record is deactivated.
//
// A further set of business rules is enforced only by the Backend — see
// database_schema.md §11 (booking-number scoping, vehicle double-booking,
// status transitions, append-only tables, pricing totals).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// The connection URL is deliberately absent: Prisma 7 no longer accepts `url`
// here. Prisma CLI / Migrate reads it from prisma.config.ts, and PrismaClient
// receives a driver adapter at construction time.

// ---------------------------------------------------------------------------
// Enums
//
// Native PostgreSQL enums are used only for stable business lifecycles.
// Concepts the model declares extensible (setting.category,
// trip_history.event_type, pricing_component.code, calendar_event.event_type)
// are plain String columns, so new values never require a migration.
// ---------------------------------------------------------------------------

/// Which half of a transport a Trip is: fetching a container or bringing it.
/// Extracted by the parser from the document's own LOADING / DELIVERY section,
/// and null on a Trip created by hand, where nobody has said which it is.
///
/// This is business data, not diagnostics: the Combination export labels a
/// leg's start and end points by it, and a value that only existed inside
/// parser_metadata could not be read for that.
enum TripDirection {
  COLLECTION
  DELIVERY

  @@map("trip_direction")
}

/// CANCELLED is a business cancellation of the transport itself.
/// DELETED is an administrative soft delete of the record and can be restored.
/// The two are deliberately distinct and must never be collapsed.
enum TripStatus {
  OPEN
  CLOSED
  CANCELLED
  DELETED

  @@map("trip_status")
}

enum MaintenanceStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("maintenance_status")
}

/// Derived from the email subject prefix (NEW: / UPDATE: / CANCEL:).
enum ImportType {
  NEW
  UPDATE
  CANCEL
  /// A cost Eucon confirms for a Trip that already exists. It never creates
  /// one, which is why it is its own action rather than a kind of UPDATE.
  COST_CONFIRMATION

  @@map("import_type")
}

enum ParserResult {
  SUCCESS
  WARNING
  FAILED
  PARTIAL_SUCCESS

  @@map("parser_result")
}

enum PricingCalculationStatus {
  CALCULATED
  FAILED
  MANUAL_OVERRIDE

  @@map("pricing_calculation_status")
}

enum EmailProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED

  @@map("email_processing_status")
}

/// A PDF may reach the system without an email, which is why
/// pdf_document.imported_email_id is nullable.
enum ImportSource {
  EMAIL
  MANUAL_UPLOAD
  API

  @@map("import_source")
}

enum SettingValueType {
  STRING
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  JSON

  @@map("setting_value_type")
}

// ---------------------------------------------------------------------------
// Import Domain
// ---------------------------------------------------------------------------

/// One email received by the IMAP Service.
/// Exists only for the email import path — manual and API imports have no row.
model ImportedEmail {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  senderEmail String    @map("sender_email") @db.Text
  subject     String    @db.Text
  /// RFC Message-ID. Unique so a reconnecting IMAP session cannot reprocess
  /// the same email and create duplicate Trips.
  messageId   String    @unique @map("message_id") @db.Text
  receivedAt  DateTime  @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  /// When the original email of a FAILED import was forwarded to a person.
  /// Null until then. Written only after the mail server accepted the forward,
  /// so an SMTP outage leaves it null and the next retry forwards again; set
  /// once, so a failure retried all day produces exactly one forward.
  failureForwardedAt DateTime? @map("failure_forwarded_at") @db.Timestamptz(6)

  processingStatus EmailProcessingStatus @default(RECEIVED) @map("processing_status")
  importType       ImportType            @map("import_type")

  /// Stored only when needed for debugging a failed import.
  body String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pdfDocument PdfDocument?

  @@index([processingStatus])
  @@index([receivedAt])
  @@map("imported_email")
}

/// One imported PDF — the immutable source of one or more Trips.
/// The binary itself lives on disk; only metadata and a path are stored here.
model PdfDocument {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  importedEmailId String?      @unique @map("imported_email_id") @db.Uuid
  importSource    ImportSource @map("import_source")

  originalFilename String @map("original_filename") @db.Text
  storagePath      String @map("storage_path") @db.Text
  fileSizeBytes    BigInt @map("file_size_bytes")
  /// Content hash used to *find* duplicates. Deliberately not unique: the same
  /// PDF may legitimately arrive twice (for example resent with an UPDATE:).
  fileHash         String @map("file_hash") @db.Text
  mimeType         String @map("mime_type") @db.Text

  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  /// Redundant with parser_run.parser_version — see database_schema.md open
  /// point O2. Kept nullable pending confirmation.
  parserVersion String? @map("parser_version") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  importedEmail ImportedEmail? @relation(fields: [importedEmailId], references: [id], onDelete: Restrict)

  parserRuns        ParserRun[]
  trips             Trip[]
  /// The Trip events this document caused — an UPDATE or a CANCEL. A NEW
  /// document is reached through `trips` instead, which is the Trip it created.
  tripHistory       TripHistory[]
  costConfirmations CostConfirmation[]

  @@index([fileHash])
  @@index([importSource])
  @@index([uploadedAt])
  @@map("pdf_document")
}

/// One execution of the PDF parser. Append-only.
/// Exists independently of Trips — a run may fail before any Trip is created.
model ParserRun {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  pdfDocumentId String @map("pdf_document_id") @db.Uuid

  parserVersion String    @map("parser_version") @db.Text
  startedAt     DateTime  @map("started_at") @db.Timestamptz(6)
  /// Null while the run is in progress, or if it crashed before finishing.
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs    Int?      @map("duration_ms")

  result       ParserResult
  warningCount Int          @default(0) @map("warning_count")
  errorCount   Int          @default(0) @map("error_count")
  errorCode    String?      @map("error_code") @db.Text
  errorMessage String?      @map("error_message") @db.Text

  /// Run-level technical diagnostics only: detected layout, confidence,
  /// detected sections, warnings, execution statistics, debug information.
  /// Never overwritten, because every execution inserts a new row — this is
  /// what makes parser comparison across versions possible.
  /// Diagnostics only: no business decision may read from this column.
  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pdfDocument PdfDocument @relation(fields: [pdfDocumentId], references: [id], onDelete: Restrict)

  @@index([pdfDocumentId])
  @@index([pdfDocumentId, startedAt])
  @@index([result])
  @@map("parser_run")
}

// ---------------------------------------------------------------------------
// Planning Domain
// ---------------------------------------------------------------------------

/// Groups the Trips of a Combination transport.
/// Holds no business data of its own — the grouping relationship is the whole
/// purpose. The Trips share the same PDF but each keeps its OWN booking number,
/// and both values live on the Trips rather than here.
model TripGroup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trips Trip[]

  @@map("trip_group")
}

/// One physical transport movement. The central entity of the system.
model Trip {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Null for a Trip created by hand: there is no source document.
  pdfDocumentId String? @map("pdf_document_id") @db.Uuid
  /// Non-null means this Trip is part of a Combination.
  /// Trip Type is derived from this column and is therefore not stored.
  tripGroupId   String? @map("trip_group_id") @db.Uuid
  vehicleId     String? @map("vehicle_id") @db.Uuid
  /// Driver OVERRIDE, not the normal assignment path. When null, the Driver is
  /// resolved through the VehicleAssignment valid on planning_date. Set only
  /// for one-off substitutions (sickness, holiday cover), and it never alters
  /// the underlying VehicleAssignment.
  driverId      String? @map("driver_id") @db.Uuid

  status TripStatus @default(OPEN)

  /// LOSRIT: a loose trip, classified as such by the operator.
  ///
  /// NOT a lifecycle state, which is why it is a column of its own rather than
  /// a TripStatus value: a Trip is LOSRIT *and* OPEN, or LOSRIT *and* CLOSED.
  /// Folding it into status would have made those combinations unrepresentable
  /// and would have broken every transition rule that reasons about the four
  /// real states.
  ///
  /// Operator-controlled and purely informational. No parser writes it, no
  /// document clears it, and pricing does not read it. False by default, so
  /// every Trip that existed before this column is an ordinary Trip.
  isLooseTrip Boolean @default(false) @map("is_loose_trip")

  /// BETAALD: whether this Trip has been paid.
  ///
  /// NOT a lifecycle state, which is why it is a column of its own rather than
  /// a TripStatus value — exactly the reasoning behind is_loose_trip above. A
  /// Trip is BETAALD *and* OPEN, or BETAALD *and* CLOSED, or CANCELLED *and*
  /// still unpaid. Folding payment into status would have made every one of
  /// those combinations unrepresentable and would have broken every transition
  /// rule that reasons about the four real states.
  ///
  /// Operator-controlled and independent of everything else. No parser writes
  /// it, no document clears it, pricing neither reads nor writes it, and
  /// changing it never touches status. False by default, so every Trip that
  /// existed before this column is NIET BETAALD — nothing is backfilled and
  /// nothing is inferred from a Cost Confirmation, which is a third party's
  /// promise to pay rather than a record that payment arrived.
  isPaid Boolean @default(false) @map("is_paid")

  /// COLLECTION fetches a container, DELIVERY brings one. Null on a manually
  /// created Trip: it is what the DOCUMENT said, and a manual Trip has none.
  /// Nullable also keeps every Trip imported before this column existed valid.
  direction TripDirection?

  /// Original PDF value, one per Trip — the two Trips of a Combination carry
  /// DIFFERENT booking numbers and are linked by trip_group_id instead.
  ///
  /// Not unique on its own: a booking may carry several containers, and each is
  /// its own Trip. The IDENTITY is
  /// (booking_number, container_number, original_planning_date); see the notes
  /// on those two columns below.
  bookingNumber   String? @map("booking_number") @db.Text
  /// Empty on a Loading until the driver reports the container.
  ///
  /// Part of the Trip's IDENTITY together with booking_number and
  /// original_planning_date, and ABSENT is part of it: a COLLECTION fetches an
  /// empty container the document cannot name, so (booking, NULL, date)
  /// identifies exactly one Trip.
  ///
  /// Enforced by a hand-written partial index, `trip_identity_key`, because
  /// Prisma can express neither half of what it needs: `NULLS NOT DISTINCT`, so
  /// two Trips with no container number collide rather than both being allowed,
  /// and `WHERE status <> 'DELETED'`, because a deleted Trip releases its
  /// identity for re-entry. TripService enforces the same rule in its own terms
  /// so the refusal is a domain error rather than a constraint violation.
  containerNumber String? @map("container_number") @db.Text
  containerType   String? @map("container_type") @db.Text
  /// Not part of the parser's validated field set, so it may be missing.
  terminal        String? @db.Text

  /// Street level is intentionally discarded; only the normalized city and
  /// country are business data. The raw text survives in parser_metadata.
  destinationCity    String? @map("destination_city") @db.Text
  destinationCountry String? @map("destination_country") @db.Text

  /// Immutable record of the date extracted at import, kept so reporting can
  /// compare original planning against the date the Administrator moved it to.
  originalPlanningDate DateTime? @map("original_planning_date") @db.Date
  planningDate         DateTime? @map("planning_date") @db.Date
  /// Planned interval. Required by the Backend to detect a Vehicle being
  /// double-booked; nullable because the parser does not guarantee times.
  startTime            DateTime? @map("start_time") @db.Time(6)
  endTime              DateTime? @map("end_time") @db.Time(6)
  /// When the transport was actually carried out; may differ from planning.
  executionDatetime    DateTime? @map("execution_datetime") @db.Timestamptz(6)

  /// The two clock times the waiting was read off, and the duration between
  /// them.
  ///
  /// The DURATION is what pricing bills from and it stays authoritative for
  /// money; the two times say where it came from, which nobody could see once
  /// only the total was kept. The Backend derives the minutes from the times
  /// whenever both are given, so the three can never disagree.
  ///
  /// Null on every Trip whose waiting time was entered before this existed:
  /// 135 minutes has unlimited begin/end pairs and inventing one would put
  /// times on screen that nobody ever read off a clock.
  ///
  /// These are TIME, not timestamps, so the day the end falls on is stated by
  /// `waitingTimeEndsNextDay`: true when the end is on the day after the
  /// begin. An end before its begin is always stored as next day; equal times
  /// without the flag are zero rather than twenty-four hours.
  ///
  /// The minutes count only the time inside 06:00 → 20:00 on each day the
  /// window touches — see `waiting-window.ts`.
  ///
  /// NOT start_time/end_time, which are the transport's own planned window.
  waitingTimeStart       DateTime? @map("waiting_time_start") @db.Time(6)
  waitingTimeEnd         DateTime? @map("waiting_time_end") @db.Time(6)
  waitingTimeEndsNextDay Boolean   @default(false) @map("waiting_time_ends_next_day")
  waitingTimeMinutes     Int?      @map("waiting_time_minutes")
  /// Manually entered. Used only by the Distance-Based pricing strategy.
  distanceKm         Decimal?  @map("distance_km") @db.Decimal(8, 2)

  /// TAR-nummer: a free-text reference the operator types in.
  ///
  /// Deliberately NOT part of the Trip's identity, and deliberately not unique:
  /// several Trips may legitimately carry the same one, and nothing looks a
  /// Trip up by it. No format is enforced — the business writes whatever their
  /// counterparty gave them, and inventing a pattern would reject real values.
  ///
  /// Whitespace-only is stored as NULL rather than as a blank string, so
  /// "absent" has exactly one representation. The Backend's `trimToNull`
  /// transform is what guarantees it, the same one `internal_notes` uses.
  ///
  /// Null on every Trip that existed before this column: nothing is backfilled
  /// and nothing is inferred.
  tarNummer String? @map("tar_nummer") @db.Text

  internalNotes String? @map("internal_notes") @db.Text

  /// Raw values extracted for THIS Trip (raw terminal, destination, address,
  /// booking number, container number, date, matched labels). Explains why the
  /// business columns hold what they hold.
  /// Parser-controlled: replaced on every reprocessing, never manual.
  /// Must not hold confidence, layout, warnings, timing or parser version —
  /// those are run-level and belong to parser_run.metadata.
  /// Diagnostics only: no business decision may read from this column.
  parserMetadata Json? @map("parser_metadata") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optional, because a Trip created by hand has no source document. Still
  /// Restrict: an imported Trip must not lose the PDF that explains it.
  pdfDocument PdfDocument? @relation(fields: [pdfDocumentId], references: [id], onDelete: Restrict)
  /// SetNull, because dissolving a group must leave both Trips intact.
  tripGroup   TripGroup?   @relation(fields: [tripGroupId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver      Driver?      @relation(fields: [driverId], references: [id], onDelete: Restrict)

  pricing           TripPricing?
  pricingOverrides  TripPricingOverride[]
  history           TripHistory[]
  customProperties  TripCustomProperty[]
  costConfirmations CostConfirmation[]

  @@index([bookingNumber])
  @@index([planningDate])
  @@index([status])
  @@index([status, planningDate])
  @@index([vehicleId, planningDate])
  @@index([tripGroupId])
  @@index([driverId])
  @@index([pdfDocumentId])
  @@map("trip")
}

/// A cost Eucon has CONFIRMED for a Trip.
///
/// Its own entity rather than a trip_history event, because it is not a record
/// of something we did — it is money a third party agreed to pay, with its own
/// identifier, its own document and its own lifetime. History explains a Trip;
/// this is a value the business acts on.
///
/// It is also NOT waiting time. Waiting time is minutes an operator enters and
/// prices through the configured rule; a confirmation is the amount Eucon will
/// pay for those minutes. Both exist on the same Trip and neither overwrites
/// the other — see database_model.md "Cost Confirmation".
///
/// Read-only once written: an external confirmation that an administrator can
/// edit is no longer a confirmation. Exactly one may exist per Trip — see the
/// unique constraint on trip_id.
model CostConfirmation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// A Trip may receive SEVERAL confirmations over time, and every one is kept.
  ///
  /// This column was UNIQUE, on the rule that Eucon confirms a Trip once and a
  /// second confirmation is refused. That is withdrawn: confirmations arrive in
  /// instalments — €100, then €25, then €40 — and the Trip is worth their SUM.
  /// Refusing the later ones lost real money and real evidence.
  ///
  /// Nothing else about the row changed. Each confirmation still carries its
  /// own document, its own `cc_number` and its own amount, and none is ever
  /// updated or deleted; a correction is a new row, as it always was.
  ///
  /// What stops the same document counting twice is `cc_number`, which is
  /// Eucon's own reference — see `CostConfirmationService.record`.
  tripId        String @map("trip_id") @db.Uuid
  /// The confirmation document itself. Non-null: an amount whose evidence
  /// cannot be produced is not a confirmation.
  pdfDocumentId String @map("pdf_document_id") @db.Uuid

  /// Eucon's own number, digits only — `CC` is a display prefix, not data.
  ccNumber String @map("cc_number") @db.Text
  /// `WAIT` on every document seen so far. Stored rather than assumed, because
  /// nothing says Eucon confirms only waiting time.
  costCode String @map("cost_code") @db.Text

  /// NUMERIC like every other amount in this schema. Never a float.
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("EUR") @db.VarChar(3)

  /// What the document was printed, as the document states it.
  receivedAt DateTime @map("received_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Restrict)
  pdfDocument PdfDocument @relation(fields: [pdfDocumentId], references: [id], onDelete: Restrict)

  /// The Ritten list shows the LATEST confirmation and pricing sums them all,
  /// so both read by Trip, newest first. `received_at` is written by the
  /// importer at the moment the document is processed.
  @@index([tripId, receivedAt(sort: Desc)])
  @@index([pdfDocumentId])
  @@map("cost_confirmation")
}

/// Append-only audit trail. Never updated, never deleted — enforced by the
/// Backend, since Prisma cannot revoke UPDATE/DELETE rights.
model TripHistory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tripId String @map("trip_id") @db.Uuid

  /// Plain text rather than an enum: the model requires the event list to stay
  /// extensible, and a new event type should not need a migration.
  eventType   String   @map("event_type") @db.Text
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Auth0 subject (`sub`) — stable even when a display name changes.
  /// See database_schema.md open point O4 for system-generated events.
  performedBy String   @map("performed_by") @db.VarChar(255)

  /// The document that caused this event: the UPDATE or CANCEL PDF.
  ///
  /// Null for an event no document caused — a status change made by hand, for
  /// instance. It lives HERE rather than as pdf_document.trip_id because one
  /// document may concern several Trips: a Combination names two bookings, and
  /// a single UPDATE for it produces one event per Trip, all pointing at the
  /// same stored PDF. The file itself is never duplicated.
  ///
  /// Restrict, for the same reason trip.pdf_document_id is: the evidence for a
  /// recorded change must not be removable while the record survives.
  pdfDocumentId String? @map("pdf_document_id") @db.Uuid

  /// JSONB so values of any column type survive without being stringified.
  previousValue Json?   @map("previous_value") @db.JsonB
  newValue      Json?   @map("new_value") @db.JsonB
  description   String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Restrict)
  pdfDocument PdfDocument? @relation(fields: [pdfDocumentId], references: [id], onDelete: Restrict)

  @@index([tripId, occurredAt(sort: Desc)])
  @@index([eventType])
  @@index([performedBy])
  @@index([pdfDocumentId])
  @@map("trip_history")
}

/// Join table between Trip and CustomProperty.
model TripCustomProperty {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tripId           String @map("trip_id") @db.Uuid
  customPropertyId String @map("custom_property_id") @db.Uuid

  /// How this assignment came to exist, and therefore who may withdraw it.
  ///
  /// True means a domain rule put it here — today only the Flat rule, which
  /// assigns Flat to every Trip whose container type requires it (see
  /// flat-container-rule.ts). Such an assignment is maintained by that rule and
  /// is removed again when the container type stops requiring it.
  ///
  /// False means a person chose it. A manual assignment is never withdrawn
  /// automatically, and never converted into an automatic one: the operator's
  /// decision outlives any rule that happens to agree with it. The default is
  /// what makes every row written before this column existed correct.
  isAutomatic Boolean @default(false) @map("is_automatic")

  /// Doubles as the "Added Timestamp" — a separate column would duplicate it.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Restrict)
  customProperty CustomProperty @relation(fields: [customPropertyId], references: [id], onDelete: Restrict)

  @@unique([tripId, customPropertyId])
  @@index([customPropertyId])
  @@map("trip_custom_property")
}

// ---------------------------------------------------------------------------
// People Domain
// ---------------------------------------------------------------------------

/// A company driver. Planning information only — authentication lives in Auth0
/// and is deliberately not linked to this table.
///
/// Requires a manual partial unique index:
///   UNIQUE (licence_number) WHERE is_active
model Driver {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Not unique: two drivers may genuinely share a name.
  name             String  @db.Text
  /// Driving licence number. Optional, because a Driver may be registered
  /// before the licence details are known. Unique among ACTIVE Drivers only,
  /// so deactivating a Driver frees the number for reuse. Never an identifier.
  licenceNumber    String? @map("licence_number") @db.Text
  phoneNumber      String? @map("phone_number") @db.Text
  email            String? @db.Text
  /// See database_schema.md open point O5.
  emergencyContact String? @map("emergency_contact") @db.Text
  notes            String? @db.Text

  /// Soft delete. Inactive Drivers keep their historical Trips but cannot be
  /// selected for new planning.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trips              Trip[]
  vacations          Vacation[]
  vehicleAssignments VehicleAssignment[]

  @@index([isActive])
  @@map("driver")
}

/// A period during which a Driver is unavailable for new planning.
/// No soft-delete flag: a vacation that was wrong is corrected or removed.
///
/// Requires a manual CHECK: end_date >= start_date.
/// Non-overlap per Driver is Backend-enforced (an EXCLUDE constraint would
/// work in PostgreSQL but cannot be expressed in Prisma).
model Vacation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  driverId String @map("driver_id") @db.Uuid

  /// Both bounds are inclusive.
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  reason String? @db.Text
  notes  String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId, startDate])
  @@index([startDate, endDate])
  @@map("vacation")
}

// ---------------------------------------------------------------------------
// Fleet Domain
// ---------------------------------------------------------------------------

/// A company truck. Carries the planning colour used across the dashboard.
///
/// Requires a manual partial unique index:
///   UNIQUE (license_plate) WHERE is_active
model Vehicle {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  licensePlate String @map("license_plate") @db.Text
  /// Presentation only, and deliberately not unique — the Administrator may
  /// reuse a colour.
  displayColor String @map("display_color") @db.Text

  description String? @db.Text
  brand       String? @db.Text
  model       String? @db.Text
  year        Int?
  notes       String? @db.Text

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trips              Trip[]
  maintenanceRecords Maintenance[]
  vehicleAssignments VehicleAssignment[]

  @@index([isActive])
  @@map("vehicle")
}

/// A company trailer. Used only for maintenance administration — there is
/// deliberately no relationship to Trip.
///
/// Requires a manual partial unique index:
///   UNIQUE (license_plate) WHERE is_active
model Trailer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  licensePlate String @map("license_plate") @db.Text

  description String? @db.Text
  brand       String? @db.Text
  model       String? @db.Text
  year        Int?
  notes       String? @db.Text

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  maintenanceRecords Maintenance[]

  @@index([isActive])
  @@map("trailer")
}

/// Historized Driver-to-Vehicle link.
///
/// This table exists so that reassigning a licence plate to a different Driver
/// does not silently rewrite the apparent Driver of every past Trip on that
/// Vehicle. A Trip resolves its Driver through the assignment that was valid on
/// its planning_date.
///
/// Requires a manual partial unique index:
///   UNIQUE (vehicle_id) WHERE valid_to IS NULL   -- one active assignment
/// Requires a manual CHECK: valid_to >= valid_from.
/// Non-overlap per Vehicle is Backend-enforced.
model VehicleAssignment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  vehicleId String @map("vehicle_id") @db.Uuid
  driverId  String @map("driver_id") @db.Uuid

  validFrom DateTime  @map("valid_from") @db.Date
  /// Null marks the currently active assignment.
  validTo   DateTime? @map("valid_to") @db.Date

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Restrict)

  /// Serves the Driver-resolution lookup for a Trip's planning date.
  @@index([vehicleId, validFrom])
  @@index([driverId])
  @@map("vehicle_assignment")
}

/// A maintenance event on exactly one asset — a Vehicle or a Trailer.
///
/// Two nullable foreign keys rather than a polymorphic asset_type/asset_id pair,
/// so PostgreSQL keeps enforcing referential integrity. The asset type is
/// implied by which key is populated, which is why no asset_type column exists.
///
/// Requires a manual CHECK: exactly one of vehicle_id / trailer_id is set.
/// Requires a manual CHECK: cost >= 0.
model Maintenance {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  vehicleId String? @map("vehicle_id") @db.Uuid
  trailerId String? @map("trailer_id") @db.Uuid

  status          MaintenanceStatus
  /// What kind of work this was — "Onderhoud", "Herstelling", "Banden".
  /// Deliberately free text and not an enum: the list is the Administrator's,
  /// and a new kind of work must never require a migration.
  maintenanceType String?           @map("maintenance_type") @db.Text
  maintenanceDate DateTime          @map("maintenance_date") @db.Date
  description     String            @db.Text

  /// Odometer reading AT THE TIME OF THIS MAINTENANCE, entered by hand. It is
  /// a historical fact about this record, never the vehicle's current mileage:
  /// the system has no odometer and must not infer one from it.
  mileage  Int?
  cost     Decimal? @db.Decimal(12, 2)
  workshop String?  @db.Text
  notes    String?  @db.Text

  /// When the next maintenance is planned, and at which odometer reading.
  /// Both are the Administrator's plan for this asset, not a schedule the
  /// system derives or maintains.
  nextMaintenanceDate    DateTime? @map("next_maintenance_date") @db.Date
  nextMaintenanceMileage Int?      @map("next_maintenance_mileage")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  trailer Trailer? @relation(fields: [trailerId], references: [id], onDelete: Restrict)

  /// The cycles of this record that were carried out, oldest first.
  completions MaintenanceCompletion[]

  @@index([vehicleId, maintenanceDate])
  @@index([trailerId, maintenanceDate])
  @@index([status])
  @@index([maintenanceDate])
  @@index([nextMaintenanceDate])
  @@map("maintenance")
}

/// One carried-out cycle of a maintenance record.
///
/// Completing maintenance does NOT create a second Maintenance row: the same
/// record is planned again on the next date and goes back to PLANNED. What
/// happened in the cycle that just ended is kept here instead, one row per
/// completion, so the record's history survives its date being moved on.
///
/// APPEND-ONLY. A row is written once, inside the transaction that re-plans its
/// record, and is never updated or deleted — there is deliberately no
/// `updatedAt`, and the repository exposes no way to change a row.
///
/// Every row is a completion: its status was, by definition, COMPLETED.
model MaintenanceCompletion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  maintenanceId String @map("maintenance_id") @db.Uuid

  /// The date the record was planned for when this cycle was carried out.
  plannedDate         DateTime @map("planned_date") @db.Date
  /// The day the work was actually done. Never in the future.
  completedOn         DateTime @map("completed_on") @db.Date
  /// The date the record was planned again for, chosen at completion.
  nextMaintenanceDate DateTime @map("next_maintenance_date") @db.Date
  /// The Administrator's extra information about this execution.
  notes               String?  @db.Text

  /// What the record described when this cycle was completed. Copied, because
  /// the record itself may be edited for the next cycle.
  maintenanceType String? @map("maintenance_type") @db.Text
  description     String  @db.Text

  /// The moment the completion was registered.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Restrict)

  @@index([maintenanceId, completedOn])
  @@map("maintenance_completion")
}

// ---------------------------------------------------------------------------
// Settings Domain
// ---------------------------------------------------------------------------

/// A configurable property assignable to Trips (TAR, Flat, Over Sint-Niklaas).
/// May contribute a pricing component.
///
/// Requires a manual partial unique index:
///   UNIQUE (name) WHERE is_active
model CustomProperty {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name        String  @db.Text
  description String? @db.Text

  /// Null makes this a FIXED-PRICE property: its amount is default_price, and
  /// its pricing line is classified CUSTOM_PROPERTY at order 7.
  ///
  /// Non-null makes it a ROUTE-PRICED property: it decides only whether the
  /// referenced component applies to a Trip, the amount comes from route_cost
  /// for the Trip's route, and the line is classified — and ordered — by that
  /// component. Toll and Tunnel are the first two.
  ///
  /// The reference exists so the Pricing Engine never has to recognise a
  /// property by name; a further route-priced property is configuration only.
  pricingComponentId String? @map("pricing_component_id") @db.Uuid

  /// The value the Pricing Engine reads at calculation time. Changing it never
  /// recalculates historical Trips — their amounts are already frozen into
  /// trip_pricing_item.
  ///
  /// Must be null when pricing_component_id is set: a route-priced property
  /// carries no price of its own, and a value here would silently never be
  /// used. Enforced by a hand-written CHECK.
  defaultPrice Decimal? @map("default_price") @db.Decimal(12, 2)

  displayOrder Int     @map("display_order")
  color        String? @db.Text

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Restrict, because a component reached through a property must not vanish
  /// from under it.
  pricingComponent PricingComponent? @relation(fields: [pricingComponentId], references: [id], onDelete: Restrict)

  tripCustomProperties TripCustomProperty[]
  tripPricingItems     TripPricingItem[]

  /// A partial UNIQUE (pricing_component_id) WHERE is_active is added by hand:
  /// two active properties pointing at one component would produce two pricing
  /// lines for a single charge.
  @@index([isActive, displayOrder])
  @@map("custom_property")
}

/// Generic key/value configuration store.
/// New settings are added as rows, never as columns, so configuration changes
/// never require a migration.
model Setting {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Plain text, not an enum: the model requires new categories to be
  /// introducible without a database change. Values are validated in the app.
  category String @db.Text
  key      String @db.Text

  /// Held as text and cast by the application according to value_type.
  /// PostgreSQL cannot validate that the cast will succeed.
  value        String           @db.Text
  valueType    SettingValueType @map("value_type")
  description  String           @db.Text
  defaultValue String?          @map("default_value") @db.Text

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Unconditional rather than active-scoped: settings are never deleted, so a
  /// key must stay unique within its category regardless of the active flag.
  @@unique([category, key])
  @@index([category])
  @@map("setting")
}

// ---------------------------------------------------------------------------
// Pricing Configuration
// ---------------------------------------------------------------------------

/// Configured base price for one route, used by the Route-Based strategy.
/// Trips do not reference it — the Pricing Engine selects the row during
/// calculation and the resulting amount is frozen into trip_pricing_item.
///
/// Requires a manual partial unique index:
///   UNIQUE (departure, destination) WHERE is_active
/// Requires a manual CHECK: base_price >= 0.
model RoutePricing {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  routeName   String @map("route_name") @db.Text
  departure   String @db.Text
  destination String @db.Text

  basePrice Decimal @map("base_price") @db.Decimal(12, 2)

  /// LEGACY — no longer read or written by the application.
  ///
  /// For a while the Toll was derived as these kilometres times one global rate.
  /// The Toll is a stored AMOUNT per route again (a TOLL row in `route_cost`,
  /// like the Tunnel), so nothing uses the distance any more. The column is kept
  /// so the distances operators entered in that period are not lost; a Trip
  /// priced then carries the distance and the rate on its own toll line.
  kilometres Decimal? @db.Decimal(8, 2)

  notes String? @db.Text

  /// Whether an administrator has been through this route's prices.
  ///
  /// ── BOOKKEEPING, NOT STATE ────────────────────────────────────────────────
  /// It records that a person has looked, and nothing else. It does not decide
  /// whether the route is used, what a Trip is charged, or anything the Pricing
  /// Engine reads — the Engine never sees this column. An unreviewed route prices
  /// exactly as a reviewed one does.
  ///
  /// Deliberately not called `active` or `status`: a route price has no lifecycle
  /// and the flag that once suggested it had was removed for good reasons.
  ///
  /// Meaningful only for an ordinary route. A LEG of a Combination is not a
  /// configuration on its own — it is never reviewed, edited or removed by
  /// itself — so its own value is never read; the group carries the mark. See
  /// `CombinationRouteGroup.reviewed`.
  reviewed Boolean @default(false)

  /// The Combination route configuration this leg belongs to, or NULL.
  ///
  /// ── THE DISCRIMINATOR ─────────────────────────────────────────────────────
  /// NULL is an ordinary route, standing on its own. Set means this row is one
  /// LEG of a Combination configuration, which always has exactly two — an
  /// outbound and a return, each with its own price, distance and tunnel.
  ///
  /// It is what keeps the two contexts apart: a normal route and a Combination
  /// leg may describe the same departure and destination without either
  /// overwriting the other, because the partial unique indexes are scoped by
  /// this column. See `database_schema.md`.
  ///
  /// A road may be a leg of MANY Combinations — everything leaving one terminal
  /// shares its outbound — so the uniqueness of a leg's road is scoped to its
  /// GROUP and not to the whole table. What may not exist twice is the PAIR of
  /// roads, which spans two rows and is therefore enforced by
  /// CombinationRoutePricingService rather than by an index.
  ///
  /// `onDelete: Cascade` is the group's own rule: removing a Combination
  /// configuration removes both its legs, and the database will not leave one
  /// behind even if something else deletes the group row.
  combinationGroupId String?                @map("combination_group_id") @db.Uuid
  combinationGroup   CombinationRouteGroup? @relation(fields: [combinationGroupId], references: [id], onDelete: Cascade)

  /// Which leg of the Combination this row is: 1 the outbound, 2 the return.
  ///
  /// NULL exactly when `combinationGroupId` is, which a CHECK enforces. The
  /// position is not decoration: `created_at` is the transaction's timestamp, so
  /// two legs written together carry the SAME one and could not be told apart by
  /// it. Leg 1 and Leg 2 are what an operator configured and must come back in
  /// that order every time.
  ///
  /// It also makes half of "exactly two legs" structural: a UNIQUE
  /// (combination_group_id, combination_leg_position) together with a CHECK
  /// restricting the position to 1 or 2 means the database itself refuses a
  /// third leg. Only the lower bound still needs the service's transaction.
  combinationLegPosition Int? @map("combination_leg_position") @db.SmallInt

  /// The route costs that belong to THIS configured route rather than to the road.
  ///
  /// Empty for an ordinary route, whose costs are matched by departure and
  /// destination as they always have been. See `RouteCost.routePricingId`.
  routeCosts RouteCost[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Added by hand: UNIQUE (combination_group_id, combination_leg_position)
  /// WHERE combination_group_id IS NOT NULL, UNIQUE (combination_group_id,
  /// departure, destination) WHERE combination_group_id IS NOT NULL, plus the
  /// CHECKs described above.
  @@index([combinationGroupId])
  @@map("route_pricing")
}

/// A Combination route CONFIGURATION: two legs priced together.
///
/// ── WHAT IT IS, AND WHAT IT IS NOT ──────────────────────────────────────────
/// This is configuration in Settings → Prijzen, not a TripGroup. A TripGroup is
/// two real Trips an operator put together, and it decides the €50 Backload;
/// this decides what the outbound and the return of a Combination COST. The two
/// are independent and neither reads the other.
///
/// ── WHY A PARENT ROW ────────────────────────────────────────────────────────
/// The group identity has to exist somewhere that cannot drift: two legs
/// pointing at each other, or a shared text key, would both allow a
/// half-configured Combination to be stored. A parent row makes the relation
/// structural — and makes "delete the Combination" one delete.
///
/// It carries no price of its own. Every amount belongs to a leg, because the
/// outbound and the return legitimately cost different things.
///
/// EXACTLY TWO legs is enforced by the service, inside one transaction, and by
/// the DTO that refuses any other number. PostgreSQL cannot express "this parent
/// has two children" without a trigger, and a trigger would be a business rule
/// living where nothing else in this schema lives.
///
/// ── THE IDENTITY OF A COMBINATION IS ITS PAIR OF LEGS ───────────────────────
/// Not either leg on its own: one road may be a leg of many Combinations, and
/// refusing that is what once made a whole import impossible. Two groups may
/// therefore hold the same road, each with its own price for it, and what may not
/// exist twice is the same PAIR. Enforced by CombinationRoutePricingService,
/// because the rule spans two rows of route_pricing and no unique index reaches
/// across rows.
model CombinationRouteGroup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  notes String? @db.Text

  /// Whether an administrator has been through this Combination's prices.
  ///
  /// On the GROUP rather than on each leg, because the group is what a person
  /// configures, edits, removes — and therefore reviews. Marking legs separately
  /// would invent a state the screen has no way to show and no meaning for: a
  /// Combination with one leg checked is not half reviewed, it is a question
  /// nobody asked.
  ///
  /// Bookkeeping only. Nothing about pricing reads it.
  reviewed Boolean @default(false)

  /// Over ST: the Combination's own Tarief, Toll and Tunnel, beside its legs.
  ///
  /// ── PART OF THE COMBINATION, NOT A THIRD LEG ──────────────────────────────
  /// It has no departure or destination, so it is not a route and is not a
  /// row of `route_pricing`; it belongs to exactly one Combination, so it lives
  /// on the group itself and goes when the group goes.
  ///
  /// Charged on LEG 2 only, when Leg 2's planningDate differs from Leg 1's — see
  /// `pricing-engine/combination-over-st.ts` and pricing_rules.md, "Over ST".
  ///
  /// NULL means nobody has stated the amount, which is not an explicit zero.
  /// Money as everywhere else: Decimal(12,2), a CHECK keeps each >= 0.
  overStBasePrice Decimal? @map("over_st_base_price") @db.Decimal(12, 2)
  overStToll      Decimal? @map("over_st_toll") @db.Decimal(12, 2)
  overStTunnel    Decimal? @map("over_st_tunnel") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  legs RoutePricing[]

  @@map("combination_route_group")
}

/// Catalog of the pricing component kinds the engine may produce.
/// The single source of truth for classifying a TripPricingItem — there is
/// deliberately no parallel type enum on the item itself.
///
/// Requires a manual partial unique index:
///   UNIQUE (code) WHERE is_active
model PricingComponent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// e.g. BASE_PRICE, FUEL_SURCHARGE, COMBINATION, WAITING_TIME, TOLL, TUNNEL,
  /// CUSTOM_PROPERTY, MANUAL_ADJUSTMENT. Text rather than an enum because
  /// components are database-driven records, not code constants.
  code        String @db.Text
  name        String @db.Text
  description String @db.Text

  displayOrder Int @map("display_order")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tripPricingItems TripPricingItem[]
  customProperties CustomProperty[]
  routeCosts       RouteCost[]

  @@index([isActive, displayOrder])
  @@map("pricing_component")
}

/// The amount of a route-dependent pricing component for one route.
///
/// Whether the component applies to a Trip is decided by trip_custom_property;
/// this table answers only how much it costs on that route. Toll and Tunnel are
/// the first two components priced this way.
///
/// Deliberately INDEPENDENT of route_pricing. A toll is incurred whichever
/// Pricing Strategy produced the base price, and route_pricing is consulted
/// only under Route-Based Pricing — so keying this table by the route itself
/// keeps route costs alive when the strategy changes. A route may have a cost
/// without a configured base price, and the reverse.
model RouteCost {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Matched against trip.terminal.
  departure   String @db.Text
  /// Matched against trip.destination_city.
  destination String @db.Text

  pricingComponentId String @map("pricing_component_id") @db.Uuid

  /// The configured route this cost belongs to, or NULL when it belongs to the ROAD.
  ///
  /// ── WHY A COST SOMETIMES NEEDS AN OWNER ───────────────────────────────────
  /// A route cost has always been matched by departure and destination, which
  /// is enough while one road has one configuration. A Combination broke that
  /// assumption: its outbound leg may run the very road an ordinary Trip also
  /// runs, and the two are priced differently — so "the tunnel of Antwerp to
  /// Kallo" stopped being a single answer.
  ///
  /// A leg therefore OWNS its costs: the row names the leg it was configured
  /// for, and editing the leg's tunnel can no longer reach the ordinary route's
  /// tunnel. NULL keeps the original meaning — a cost of the road itself — so
  /// every existing row and every ordinary route behaves exactly as before.
  ///
  /// `onDelete: Cascade` because such a cost has no meaning without its leg.
  routePricingId String?       @map("route_pricing_id") @db.Uuid
  routePricing   RoutePricing? @relation(fields: [routePricingId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)
  notes  String? @db.Text

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pricingComponent PricingComponent @relation(fields: [pricingComponentId], references: [id], onDelete: Restrict)

  /// Two partial UNIQUE indexes and a CHECK (amount >= 0) are added by hand: one
  /// on (departure, destination, pricing_component_id) for the costs of a ROAD,
  /// one on (route_pricing_id, pricing_component_id) for those owned by a leg,
  /// each WHERE is_active.
  @@index([departure, destination])
  @@index([pricingComponentId])
  @@index([routePricingId])
  @@map("route_cost")
}

// ---------------------------------------------------------------------------
// Pricing Domain
// ---------------------------------------------------------------------------

/// The calculated pricing summary for one Trip.
///
/// Exists only once the Trip reaches CLOSED — PostgreSQL cannot express that
/// cross-table conditional existence, so the Backend enforces it.
/// Reprocessing overwrites this row using current Settings; no previous
/// version is retained.
///
/// Requires a manual CHECK: total_price >= 0.
model TripPricing {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Unique, giving Trip a one-to-zero-or-one pricing result.
  tripId String @unique @map("trip_id") @db.Uuid

  /// Must equal the sum of the related items — a cross-table aggregate the
  /// Backend is responsible for keeping true.
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)
  currency   String  @default("EUR") @db.Char(3)

  calculatedAt         DateTime @map("calculated_at") @db.Timestamptz(6)
  pricingEngineVersion String   @map("pricing_engine_version") @db.Text
  pricingRuleVersion   String   @map("pricing_rule_version") @db.Text

  calculationStatus PricingCalculationStatus @map("calculation_status")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip  Trip              @relation(fields: [tripId], references: [id], onDelete: Restrict)
  items TripPricingItem[]

  @@index([calculatedAt])
  @@index([calculationStatus])
  @@map("trip_pricing")
}

/// One component of a pricing calculation.
/// Every element is its own row so a new pricing rule never requires a schema
/// An amount an operator set by hand, replacing what the Engine calculated.
///
/// ── WHY THIS IS NOT A COLUMN ON trip_pricing_item ──────────────────────────
/// Recalculation DELETES every item and recreates it from the Engine — see
/// TripPricingService.replaceSnapshot. An override living on the item would be
/// destroyed by the next waiting-time edit, which is the one thing an override
/// must never be. Keyed by Trip and component code, it survives every
/// recalculation by construction.
///
/// ── WHAT IT IS NOT ─────────────────────────────────────────────────────────
/// Not a second pricing engine and not a history. It records that a person
/// disagreed with a calculated figure, and by how much they said it should be.
/// The Engine's own snapshot stays untouched beside it, so what the rules
/// produced and what the operator decided are both still readable.
///
/// Others and Totaal are deliberately NOT storable here: Others is a grouping
/// of two calculated components and Totaal is a sum, so neither is a thing an
/// operator can hold an opinion about directly. They are corrected by
/// overriding what they are made of.
model TripPricingOverride {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tripId String @map("trip_id") @db.Uuid

  /// The catalog code this replaces: BASE_PRICE, TOLL, COST_CONFIRMATION, …
  ///
  /// Text matching pricing_component.code rather than a foreign key to it: the
  /// override outlives any single snapshot, and binding it to a catalog row
  /// would make deactivating a component silently drop an operator's decision.
  componentCode String @map("component_code") @db.Text

  /// NUMERIC like every other amount here. Never a float.
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("EUR") @db.Char(3)

  /// Auth0 subject (`sub`) — stable even when a display name changes.
  overriddenBy String @map("overridden_by") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Restrict, like every other financial reference: a Trip carrying a manual
  /// correction is not something a delete should take with it.
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)

  /// One opinion per component per Trip. A second correction REPLACES the
  /// first rather than accumulating, which is what an operator means by
  /// changing a price twice.
  @@unique([tripId, componentCode])
  @@index([tripId])
  @@map("trip_pricing_override")
}

/// change — it only requires a new PricingComponent record.
model TripPricingItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tripPricingId      String  @map("trip_pricing_id") @db.Uuid
  pricingComponentId String  @map("pricing_component_id") @db.Uuid
  /// Set when the item originates from a Custom Property, so the breakdown can
  /// name exactly which property produced the amount.
  customPropertyId   String? @map("custom_property_id") @db.Uuid

  description String  @db.Text
  /// Intentionally unconstrained in sign — database_model.md §4.14 allows
  /// negative items. See database_schema.md open point O6.
  amount      Decimal @db.Decimal(12, 2)
  currency    String  @default("EUR") @db.Char(3)

  /// Preserves the calculation sequence defined in pricing_rules.md.
  /// Not unique: ordering is required, uniqueness is not.
  calculationOrder Int @map("calculation_order")

  quantity  Decimal? @db.Decimal(12, 2)
  unitPrice Decimal? @map("unit_price") @db.Decimal(12, 2)
  notes     String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Cascade, because reprocessing replaces the whole item set with its parent.
  tripPricing      TripPricing      @relation(fields: [tripPricingId], references: [id], onDelete: Cascade)
  pricingComponent PricingComponent @relation(fields: [pricingComponentId], references: [id], onDelete: Restrict)
  customProperty   CustomProperty?  @relation(fields: [customPropertyId], references: [id], onDelete: Restrict)

  @@index([tripPricingId, calculationOrder])
  @@index([pricingComponentId])
  @@index([customPropertyId])
  @@map("trip_pricing_item")
}

// ---------------------------------------------------------------------------
// Calendar Domain
// ---------------------------------------------------------------------------

/// An event in the Administrator's internal calendar.
/// Fully independent from Trips, and may be physically deleted.
///
/// Requires a manual CHECK: end_date >= start_date.
model CalendarEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  title       String  @db.Text
  description String? @db.Text
  /// e.g. MEETING, REMINDER, PERSONAL, MAINTENANCE, OTHER. Text rather than an
  /// enum because the model expects new event types over time.
  eventType   String  @map("event_type") @db.Text

  startDate DateTime  @map("start_date") @db.Date
  startTime DateTime  @map("start_time") @db.Time(6)
  /// Null for a single-day event.
  endDate   DateTime? @map("end_date") @db.Date
  endTime   DateTime? @map("end_time") @db.Time(6)

  color String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([startDate])
  @@index([eventType])
  @@map("calendar_event")
}

/// A free-form administrator note: its text, and nothing else. Standalone, with
/// no business relationships, and may be physically deleted.
model Note {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The note itself: plain text, line breaks kept, never empty.
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Supports most-recently-edited ordering in the notes list.
  @@index([updatedAt])
  @@map("note")
}

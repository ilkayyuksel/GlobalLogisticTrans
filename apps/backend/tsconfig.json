{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "moduleResolution": "node",
    "outDir": "./dist",
    "baseUrl": "./",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "removeComments": true,

    // The build cache must live inside outDir. Nest's `deleteOutDir` removes
    // dist/ but not a cache stored beside the tsconfig, and tsc would then read
    // a cache claiming every file was already emitted — producing an empty
    // dist/ and a silent, exit-code-0 build failure.
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

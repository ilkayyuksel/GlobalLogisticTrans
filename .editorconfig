# https://editorconfig.org
# Keeps whitespace consistent regardless of which editor a contributor uses.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses trailing double-spaces as a hard line break, so trimming them
# would silently change how the documentation renders.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.prisma]
indent_size = 2

[*.sql]
indent_size = 4

[Makefile]
indent_style = tab

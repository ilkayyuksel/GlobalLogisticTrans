# TRAXO — production environment template.
#
# On the server:
#
#   cp .env.production.example .env
#   nano .env                       # fill in every REQUIRED value
#   docker compose up -d
#
# Compose reads `.env`. This file is the template that says what belongs in it,
# and it is committed; `.env` never is.
#
# ── SECRETS ─────────────────────────────────────────────────────────────────
# Four values here are real credentials: POSTGRES_PASSWORD, AUTH0_CLIENT_SECRET,
# AUTH0_SECRET and IMAP_PASSWORD. They exist only in the server's `.env` — never
# in Git, never in an image, never in a log line.
# ────────────────────────────────────────────────────────────────────────────
#
# ── HOW TO READ THIS FILE ───────────────────────────────────────────────────
#   [REQUIRED]  the stack refuses to start without it
#   [OPTIONAL]  has a working default; set it only to change behaviour
# ────────────────────────────────────────────────────────────────────────────

# =============================================================================
# Database
# =============================================================================
# [REQUIRED] PostgreSQL is created with these on first start. Generate a real
# password once and keep it:  openssl rand -base64 32
#
# Changing POSTGRES_PASSWORD later does NOT change the password inside an
# existing database — it is only read when the data volume is first created.
POSTGRES_DB=traxo
POSTGRES_USER=traxo
POSTGRES_PASSWORD=

# DATABASE_URL is NOT set here. The stack composes it from the three values
# above against the `postgres` service name, because inside a container
# "localhost" is the container itself. Setting it by hand is how a deployment
# ends up pointing at nothing.

# =============================================================================
# Deployment — hostnames and certificates
# =============================================================================
# [REQUIRED] The names Traefik answers on. DNS for all three must point at this
# server BEFORE the first start, or Let's Encrypt cannot issue certificates.
APP_HOST=trano.be
APP_HOST_WWW=www.trano.be
API_HOST=api.trano.be

# [REQUIRED] Where Let's Encrypt sends expiry warnings. A mailbox you read.
ACME_EMAIL=

# [OPTIONAL] Image tag the stack builds and runs. Blank means "latest".
TRAXO_VERSION=

# =============================================================================
# Frontend
# =============================================================================
# [REQUIRED] Where the application is reached. The Auth0 SDK builds its callback
# and logout URLs from this, so it must match what Auth0 allows, exactly.
APP_BASE_URL=https://trano.be

# [REQUIRED] Where the BROWSER calls the API — a public URL, never a compose
# service name.
#
# Next inlines this at BUILD time. Changing it needs
# `docker compose build frontend`, not merely a restart.
NEXT_PUBLIC_API_URL=https://api.trano.be

# =============================================================================
# Authentication (Auth0)
# =============================================================================
# TRAXO has no password of its own: Auth0 owns the administrator's identity and
# this repository stores business data only. Never put a password in this file.

# [REQUIRED] The tenant, without a scheme: traxo.eu.auth0.com
AUTH0_DOMAIN=

# [REQUIRED] The Regular Web Application in Auth0. The ID is public; the secret
# is a credential and must never reach a NEXT_PUBLIC_* variable.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# [REQUIRED] Encrypts the session cookie:  openssl rand -hex 32
# Changing it signs everyone out, which is all it affects.
AUTH0_SECRET=

# [REQUIRED] The API identifier the backend verifies tokens against.
AUTH0_AUDIENCE=

# [OPTIONAL] The single administrator this deployment admits, by Auth0 subject
# ("auth0|abc123") or by email, comma-separated. Empty admits any user the
# tenant authenticates — correct while the tenant holds exactly one user.
AUTH0_ALLOWED_SUBJECTS=

# [OPTIONAL] Whether the API requires a valid access token. Production must
# leave this true; false disables ALL API protection.
ENABLE_AUTH=true

# [OPTIONAL] Scopes requested at login.
AUTH0_SCOPE=openid profile email

# =============================================================================
# Backend
# =============================================================================
# [OPTIONAL] The port inside the container. Traefik routes to it; it is never
# published. Changing it means changing the compose labels too.
API_PORT=3000

# [OPTIONAL] error | warn | info | debug | verbose
LOG_LEVEL=info

# CORS_ORIGINS is not set here: the stack sets it to APP_BASE_URL, so the API
# accepts the application and nothing else.

# =============================================================================
# PDF storage
# =============================================================================
# [OPTIONAL] Where transport orders are written inside the container. A named
# volume is mounted here, so the files survive rebuilds and container
# replacement. Leave it as it is unless the volume mount changes with it.
PDF_STORAGE_DIR=/app/storage/pdf

# [OPTIONAL] Largest PDF a manual upload may carry, in megabytes.
PDF_UPLOAD_MAX_SIZE_MB=20

# =============================================================================
# IMAP — mailbox ingestion
# =============================================================================
# Off unless ENABLE_IMAP is exactly "true". When on, HOST, USERNAME, PASSWORD
# and TRUSTED_SENDERS are validated at startup, so a missing credential fails
# the boot rather than a scan at three in the morning.
ENABLE_IMAP=true
IMAP_HOST=imap.mailprotect.be
IMAP_PORT=1993
IMAP_USERNAME=
# [REQUIRED when ENABLE_IMAP=true] A real credential. Server `.env` only.
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_FOLDER=INBOX

# Who may create Trips by email. Two forms:
#   planning@eucon.nl   one exact address, and only that address
#   *@eucon.nl          any local part at exactly that domain
# The wildcard compares the domain for EQUALITY, so it accepts orders@eucon.nl
# but never planning@sub.eucon.nl or planning@eucon.nl.evil.com. Anything
# broader — *, *@*, a regular expression — stops the application at startup.
# An empty list trusts NOBODY, never "everyone".
IMAP_TRUSTED_SENDERS=*@eucon.nl

# Subject prefix announcing a new transport order, matched case-insensitively.
# UPDATE: and CANCEL: are carried out as well.
MAIL_SUBJECT_NEW=NEW:

# Six-field cron (seconds first). Every five minutes.
IMAP_POLL_CRON=0 */5 * * * *

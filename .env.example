# Copy this file to .env and fill in the values:
#
#   cp .env.example .env
#
# .env is NEVER committed. It holds the database password, the Auth0 secret and
# the mailbox password.
#
# ── HOW TO READ THIS FILE ───────────────────────────────────────────────────
# One file serves both a developer machine and a deployed server. Every variable
# is marked:
#
#   [PRODUCTION]   required by `docker compose up -d`; the stack will not work
#                  without it
#   [OPTIONAL]     has a sensible default; set it only to change behaviour
#   [DEVELOPMENT]  used when running from source; the production stack ignores
#                  it entirely
#
# The production stack composes DATABASE_URL, PDF_STORAGE_DIR, API_PORT and
# CORS_ORIGINS itself from the values below — see docker-compose.yml — so those
# are marked [DEVELOPMENT] here.
# ────────────────────────────────────────────────────────────────────────────

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# [PRODUCTION] The credentials PostgreSQL is created with, and that the backend
# connects with. On a server, generate a real password:
#   openssl rand -base64 32
# Changing POSTGRES_PASSWORD after the volume exists does NOT change the
# password in the database — it is only read when the volume is first created.
POSTGRES_USER=tms
POSTGRES_PASSWORD=tms_local_password
POSTGRES_DB=tms

# [DEVELOPMENT] Host port for the development database container. The production
# stack publishes NO database port at all.
POSTGRES_PORT=5432

# [DEVELOPMENT] Read by Prisma on the HOST — the CLI, Migrate, Studio and the
# seed script — and by the backend when it runs from source. Note "localhost".
# The production stack builds its own URL against the `postgres` service name
# and ignores this value.
DATABASE_URL=postgresql://tms:tms_local_password@localhost:5432/tms

# -----------------------------------------------------------------------------
# PgAdmin  [DEVELOPMENT]
# -----------------------------------------------------------------------------
# Only docker-compose.dev.yml starts pgadmin. A server never runs it.
# PGADMIN_DEFAULT_EMAIL must be a syntactically valid email address or the
# container refuses to start. It is never used to send mail.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_local_password
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Deployment  [PRODUCTION]
# -----------------------------------------------------------------------------
# The hostnames the reverse proxy answers on. DNS for all three must point at
# this server before certificates can be issued.
APP_HOST=trano.be
APP_HOST_WWW=www.trano.be
API_HOST=api.trano.be

# Where Let's Encrypt sends expiry warnings. A real mailbox you read.
ACME_EMAIL=

# [OPTIONAL] Image tag the stack builds and runs. Leave blank for "latest".
TRAXO_VERSION=

# -----------------------------------------------------------------------------
# Application settings
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Authentication (Auth0)
# -----------------------------------------------------------------------------
# TRAXO has no password of its own. Auth0 owns the identity of the single
# administrator, this repository stores business data only, and there is no
# users, sessions or roles table anywhere in the schema.
#
# NEVER put a password in this file or in .env. The administrator's password is
# set in the Auth0 dashboard and exists nowhere in this codebase.

# The tenant, without a scheme: traxo.eu.auth0.com
# Used by the frontend to start the login flow and by the backend to derive the
# issuer and the JWKS URL it verifies tokens against.
# [PRODUCTION]
AUTH0_DOMAIN=

# The Regular Web Application in Auth0. The ID is public; the secret is not, and
# it must never be exposed through a NEXT_PUBLIC_* variable.
# [PRODUCTION] Frontend only. The secret is a real credential.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Encrypts the session cookie the Next.js SDK sets. Any 32-byte random string:
#   openssl rand -hex 32
# Changing it signs everyone out, which is the only thing it affects.
# [PRODUCTION]
AUTH0_SECRET=

# Where the application is reached, used to build the callback and logout URLs.
# It must match what Auth0 is configured to allow, exactly.
#   local:      http://localhost:3100
#   production: https://<TRAXO-DOMAIN>
# The Auth0 SDK v4 reads this variable; earlier versions called it
# AUTH0_BASE_URL.
# [PRODUCTION] Must be the https:// URL, and must match APP_HOST above.
APP_BASE_URL=http://localhost:3100

# The API identifier of the Auth0 API that represents the TRAXO backend, e.g.
#   https://api.traxo.example
# The frontend asks for an access token FOR this audience, and the backend
# refuses any token minted for a different one. Without it, Auth0 returns an
# opaque token the backend cannot verify.
# [PRODUCTION]
AUTH0_AUDIENCE=

# Backend: whether the API requires a valid access token. Defaults to true, and
# every deployment must leave it that way. Setting it to false is a local
# development state for a machine with no Auth0 tenant yet — it disables ALL
# API protection.
# [OPTIONAL] Defaults to true. A deployment must never set it to false.
ENABLE_AUTH=true

# Optional. The single administrator this deployment admits, by Auth0 subject
# ("auth0|abc123") or by email, comma-separated. Empty means any user the tenant
# authenticates, which is correct while the tenant holds exactly one user.
# Identifiers only — never a credential.
# [OPTIONAL]
AUTH0_ALLOWED_SUBJECTS=

# Backend
# The backend validates these at startup and refuses to boot if any is invalid.
# NODE_ENV   : development | production | test
# LOG_LEVEL  : error | warn | info | debug | verbose
# CORS_ORIGINS: comma-separated list of allowed origins.
#               "*" is accepted for local development only.
# [DEVELOPMENT] The production stack sets NODE_ENV, API_PORT and CORS_ORIGINS
# itself; CORS there is exactly APP_BASE_URL, never "*".
NODE_ENV=development
API_PORT=3000
# [OPTIONAL] error | warn | info | debug | verbose. Production defaults to info.
LOG_LEVEL=debug
CORS_ORIGINS=*

# Where imported transport-order PDFs are written. A relative path is resolved
# from the backend's working directory, so the default lands in the repository's
# gitignored storage/pdf. Leave blank to accept that default; a deployment sets
# an absolute path, because the files must outlive the checkout.
# [DEVELOPMENT] In production this is fixed to /app/storage/pdf, a named volume.
PDF_STORAGE_DIR=

# The largest PDF a manual upload may carry, in megabytes. Real transport orders
# are well under one megabyte; the limit bounds what a single request can make
# the backend hold in memory. Leave blank for the conservative default (10).
# [OPTIONAL]
PDF_UPLOAD_MAX_SIZE_MB=

# Frontend
# [PRODUCTION] Where the BROWSER reaches the API — a public URL, not a compose
# service name. Next inlines it at BUILD time, so changing it requires
# `docker compose build frontend`, not merely a restart.
#   local:      http://localhost:3000
#   production: https://api.trano.be
NEXT_PUBLIC_API_URL=

# [OPTIONAL] Scopes requested at login. The default suits a single administrator.
AUTH0_SCOPE=

# IMAP
# Mailbox ingestion is OFF unless ENABLE_IMAP is exactly "true". While it is
# off, none of the settings below are required and the backend starts without
# them. When it is on, HOST, USERNAME, PASSWORD and TRUSTED_SENDERS are all
# validated at startup, so a missing credential fails the boot rather than a
# scan at three in the morning.
# [OPTIONAL] Off by default; everything below is required once it is on.
ENABLE_IMAP=false
IMAP_HOST=
# 993 is implicit TLS, the default. Use 143 only with IMAP_TLS=false.
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_FOLDER=INBOX
# Comma-separated whitelist of who may create Trips by email. Two forms:
#   planning@eucon.nl   one exact address, and only that address
#   *@eucon.nl          any local part at exactly that domain
# The wildcard is matched by comparing the domain for EQUALITY, so it accepts
# orders@eucon.nl but never planning@sub.eucon.nl or planning@eucon.nl.evil.com.
# Nothing broader is accepted: *, *@* and regex-shaped entries stop the
# application at startup. An empty list trusts NOBODY — never "everyone".
IMAP_TRUSTED_SENDERS=
# Subject prefix announcing a new transport order. Matched case-insensitively.
# UPDATE: and CANCEL: are carried out as well: an UPDATE revises the Trip that
# holds the booking number, a CANCEL cancels it. The sender rule above decides
# WHO may send; these prefixes decide WHAT is done.
MAIL_SUBJECT_NEW=NEW:
# Six-field cron (seconds first). Default: every five minutes.
IMAP_POLL_CRON=0 */5 * * * *

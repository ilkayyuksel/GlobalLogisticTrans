# Copy this file to .env and fill in the values:
#
#   cp .env.example .env
#
# .env is never committed. Only the variables in the "Database" and "PgAdmin"
# sections below are required to run the local database environment; the rest
# belong to applications that do not exist yet and may stay empty for now.

# -----------------------------------------------------------------------------
# Database  (REQUIRED)
# -----------------------------------------------------------------------------
# POSTGRES_* are consumed by docker-compose.yml to provision the container.
# Choose any values you like — this database is local and disposable.
POSTGRES_USER=tms
POSTGRES_PASSWORD=tms_local_password
POSTGRES_DB=tms
# Host port mapped to the container. Change if 5432 is already in use locally.
POSTGRES_PORT=5432

# DATABASE_URL is consumed by Prisma (CLI, Migrate, Studio and the seed script).
# It MUST stay consistent with the four POSTGRES_* values above:
#   postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:POSTGRES_PORT/POSTGRES_DB
# Note "localhost": Prisma runs on the host, not inside the Docker network.
DATABASE_URL=postgresql://tms:tms_local_password@localhost:5432/tms

# -----------------------------------------------------------------------------
# PgAdmin  (REQUIRED)
# -----------------------------------------------------------------------------
# PGADMIN_DEFAULT_EMAIL must be a syntactically valid email address or the
# container refuses to start. It is never used to send mail.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_local_password
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Application settings — not required for the database environment
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Authentication (Auth0)
# -----------------------------------------------------------------------------
# TRAXO has no password of its own. Auth0 owns the identity of the single
# administrator, this repository stores business data only, and there is no
# users, sessions or roles table anywhere in the schema.
#
# NEVER put a password in this file or in .env. The administrator's password is
# set in the Auth0 dashboard and exists nowhere in this codebase.

# The tenant, without a scheme: traxo.eu.auth0.com
# Used by the frontend to start the login flow and by the backend to derive the
# issuer and the JWKS URL it verifies tokens against.
AUTH0_DOMAIN=

# The Regular Web Application in Auth0. The ID is public; the secret is not, and
# it must never be exposed through a NEXT_PUBLIC_* variable.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Encrypts the session cookie the Next.js SDK sets. Any 32-byte random string:
#   openssl rand -hex 32
# Changing it signs everyone out, which is the only thing it affects.
AUTH0_SECRET=

# Where the application is reached, used to build the callback and logout URLs.
# It must match what Auth0 is configured to allow, exactly.
#   local:      http://localhost:3100
#   production: https://<TRAXO-DOMAIN>
# The Auth0 SDK v4 reads this variable; earlier versions called it
# AUTH0_BASE_URL.
APP_BASE_URL=http://localhost:3100

# The API identifier of the Auth0 API that represents the TRAXO backend, e.g.
#   https://api.traxo.example
# The frontend asks for an access token FOR this audience, and the backend
# refuses any token minted for a different one. Without it, Auth0 returns an
# opaque token the backend cannot verify.
AUTH0_AUDIENCE=

# Backend: whether the API requires a valid access token. Defaults to true, and
# every deployment must leave it that way. Setting it to false is a local
# development state for a machine with no Auth0 tenant yet — it disables ALL
# API protection.
ENABLE_AUTH=true

# Optional. The single administrator this deployment admits, by Auth0 subject
# ("auth0|abc123") or by email, comma-separated. Empty means any user the tenant
# authenticates, which is correct while the tenant holds exactly one user.
# Identifiers only — never a credential.
AUTH0_ALLOWED_SUBJECTS=

# Backend
# The backend validates these at startup and refuses to boot if any is invalid.
# NODE_ENV   : development | production | test
# LOG_LEVEL  : error | warn | info | debug | verbose
# CORS_ORIGINS: comma-separated list of allowed origins.
#               "*" is accepted for local development only.
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=*

# Where imported transport-order PDFs are written. A relative path is resolved
# from the backend's working directory, so the default lands in the repository's
# gitignored storage/pdf. Leave blank to accept that default; a deployment sets
# an absolute path, because the files must outlive the checkout.
PDF_STORAGE_DIR=

# The largest PDF a manual upload may carry, in megabytes. Real transport orders
# are well under one megabyte; the limit bounds what a single request can make
# the backend hold in memory. Leave blank for the conservative default (10).
PDF_UPLOAD_MAX_SIZE_MB=

# Frontend
NEXT_PUBLIC_API_URL=

# Parser

# IMAP
# Mailbox ingestion is OFF unless ENABLE_IMAP is exactly "true". While it is
# off, none of the settings below are required and the backend starts without
# them. When it is on, HOST, USERNAME, PASSWORD and TRUSTED_SENDERS are all
# validated at startup, so a missing credential fails the boot rather than a
# scan at three in the morning.
ENABLE_IMAP=false
IMAP_HOST=
# 993 is implicit TLS, the default. Use 143 only with IMAP_TLS=false.
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_FOLDER=INBOX
# Comma-separated. ONLY these exact addresses may create Trips by email —
# matching is exact, never by domain, so listing a domain trusts nothing.
# Required when ENABLE_IMAP=true; there is deliberately no default.
IMAP_TRUSTED_SENDERS=
# Subject prefix announcing a new transport order. Matched case-insensitively.
# UPDATE: and CANCEL: emails are recognised but NOT imported by this version;
# they are recorded as IGNORED so they can be found when support is added.
MAIL_SUBJECT_NEW=NEW:
# Six-field cron (seconds first). Default: every five minutes.
IMAP_POLL_CRON=0 */5 * * * *

# Storage
STORAGE_PATH=
